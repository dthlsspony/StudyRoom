# Проект полностью контейнерный: текст должен оставаться с LF, иначе
# entrypoint-скрипты и конфиги Docker перестают работать на Windows.
* text=auto eol=lf

*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf
*.conf text eol=lf
*.ini text eol=lf
*.php text eol=lf
*.json text eol=lf
*.lock text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.env text eol=lf
*.example text eol=lf

# Бинарники
*.png binary
*.jpg binary
*.ico binary
*.sqlite binary
