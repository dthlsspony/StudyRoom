# ---- Application ----
APP_NAME=StudyRoom
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080
VITE_PORT=5173

# ---- Database (PostgreSQL) ----
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
# Порт БД на хосте (публикуется Docker'ом). Если 5432 на сервере уже занят
# своим Postgres — поставьте свободный, например 5433. На работу приложения
# это не влияет: внутри сети Docker БД всегда на 5432.
DB_PUBLISHED_PORT=5432
DB_DATABASE=studyroom
DB_USERNAME=studyroom
DB_PASSWORD=studyroom

# ---- LiveKit ----
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_change_me_0123456789abcdefghij
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_URL=http://livekit:7880
LIVEKIT_WEBHOOK_URL=http://web/api/v1/livekit/webhook

# ---- Порты, публикуемые на хосте (docker-compose) ----
# LIVEKIT_HTTP_PORT — сигналинг (WebSocket): на этот порт смотрит обратный прокси.
LIVEKIT_HTTP_PORT=7880
# LIVEKIT_TCP_PORT — ICE поверх TCP, запасной транспорт для медиа.
LIVEKIT_TCP_PORT=7881
# LIVEKIT_UDP_PORT — медиа по UDP. LiveKit объявляет этот порт в ICE-кандидатах,
# поэтому он должен совпадать с портом, открытым в firewall.
LIVEKIT_UDP_PORT=7882

# ---- Laravel Reverb (websockets for chat) ----
REVERB_APP_ID=studyroom
REVERB_APP_KEY=studyroomappkey
REVERB_APP_SECRET=studyroomappsecret
REVERB_HOST=localhost
# Внутренний порт Reverb: backend и Reverb в одном контейнере, его не меняем.
REVERB_PORT=8081
# Порт Reverb на хосте — его публикует Docker. Если 8081 на сервере занят,
# поставьте свободный (в бою Reverb ходит через домен, порт не важен).
REVERB_PUBLISHED_PORT=8081
REVERB_SCHEME=http

# --- Frontend (Vite) ---
VITE_REVERB_KEY=studyroomappkey
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8081
VITE_REVERB_SCHEME=http

# --- LiveKit: адрес, который сервер объявляет в ICE-кандидатах ---
# Это IP этой машины в локальной сети: браузер идёт по нему на опубликованный
# UDP-порт. Узнать: ipconfig (Windows) / ip -4 addr (Linux) / ifconfig (macOS).
# На сервере с публичным IP оставьте пустым — LiveKit определит адрес сам.
LIVEKIT_NODE_IP=192.168.0.106

