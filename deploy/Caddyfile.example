# Caddy на хосте перед Docker-стеком StudyRoom.
#
#   study-room.quietroom.name  → контейнер web (хостовый порт APP_PORT, по умолчанию 8080)
#                                фронтенд + /api/* + WebSocket чата /app/{REVERB_APP_KEY}
#   livekit.quietroom.name     → контейнер livekit (хостовый порт LIVEKIT_HTTP_PORT,
#                                по умолчанию 7880): сигналинг LiveKit
#
# Номера портов ниже должны совпадать с .env:
#   APP_PORT=8082            → published порт контейнера web
#   LIVEKIT_HTTP_PORT=7882   → published порт сигналинга LiveKit
#
# Caddy сам выпускает и обновляет сертификаты Let's Encrypt (нужны DNS на этот
# хост и открытые 80/443). WebSocket-апгрейд reverse_proxy обрабатывает сам.
#
# Медиа WebRTC идёт мимо прокси напрямую: в firewall должен быть открыт
# LIVEKIT_UDP_PORT (по умолчанию 7882/udp) — именно этот порт LiveKit
# объявляет в ICE-кандидатах. TCP-порт 7881 (ICE поверх TCP) — запасной.
#
# Запуск: caddy run --config /etc/caddy/Caddyfile
# Проверка конфига: caddy validate --config /etc/caddy/Caddyfile
#
# Если сертификат не выпускается — смотрите лог Caddy:
#   journalctl -u caddy -n 100 --no-pager | grep -iE "acme|challenge|certificate|error"
# Типовые причины: сервер не достучится до ACME-сервиса (закрыт исходящий
# 443), не проброшен порт 80 для проверки домена, истёк лимит Let's Encrypt,
# либо у домена есть AAAA-запись, указывающая на недоступный адрес.
# Проверить, что сертификат вообще выпущен: https://crt.sh/?q=ваш-домен
# (в выдаче должен появиться домен).

{
	# Почта для аккаунта ACME — по ней приходят уведомления об истечении
	# сертификата. Без неё Caddy всё равно выпустит сертификат, но вы его
	# не увидите заранее.
	email admin@quietroom.name

	# Писать логи в stdout (docker/systemd) — или задать свой формат:
	# log {
	#     output file /var/log/caddy/studyroom.log
	#     format json
	# }
}

study-room.quietroom.name {
	encode gzip zstd

	reverse_proxy 127.0.0.1:8082 {
		# Долгие WebSocket-соединения чата (Reverb) не рвём по таймауту.
		transport http {
			read_timeout 0
			write_timeout 0
		}
	}
}

livekit.quietroom.name {
	reverse_proxy 127.0.0.1:7882 {
		transport http {
			read_timeout 0
			write_timeout 0
		}
	}
}

# Если DNS ещё не настроен и нужен сертификат сейчас — раскомментируйте
# самоподписанный вариант (браузер предупредит о сертификате):
#
# study-room.quietroom.name {
#     tls internal
#     reverse_proxy 127.0.0.1:8082
# }
